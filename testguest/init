#!/bin/busybox sh
# vmkit contract-suite guest. Kernel arguments:
#   vmkit.test=<action>  up | reboot | panic | exit | idle | vsock | disks | sector0 | net | count
#   vmkit.exit=<method>  poweroff | reboot  (how "up", "vsock", "disks" and "net" end)
#   vmkit.ip=<addr/len> vmkit.gw=<addr>  configure eth0 (with vmkit.test=net)
#   vmkit.ip6=<addr/len> vmkit.gw6=<addr>  and its IPv6 side
#   vmkit.probe=<ip>:<port>  try a TCP connection (repeatable); an IPv6 <ip> is in brackets
#   vmkit.dns=<name>         resolve a name through the gateway (repeatable)
#   vmkit.spoof=<addr/len>   then probe the IPv4 targets again from this unassigned source address
#   vmkit.spoof6=<addr/len>  and the IPv6 targets from this one
#   vmkit.serve=<port>       serve HTTP on this port ("VMKIT-SERVED"), then wait for vmkit.hold=<seconds>
#   vmkit.mark=<word>        with vmkit.test=count: written to sector 0 of vda, if there is one
#   vmkit.vsock=<port>       with vmkit.test=count: try a vsock connection to the host each tick
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sys /sys
/bin/busybox mount -t devtmpfs dev /dev
action=up
method=poweroff
ip= gw= ip6= gw6= probes= names= spoof= spoof6= serve= hold=0 mark=1 vport=
for arg in $(/bin/busybox cat /proc/cmdline); do
  case $arg in
    vmkit.test=*) action=${arg#vmkit.test=} ;;
    vmkit.exit=*) method=${arg#vmkit.exit=} ;;
    vmkit.ip=*) ip=${arg#vmkit.ip=} ;;
    vmkit.gw=*) gw=${arg#vmkit.gw=} ;;
    vmkit.ip6=*) ip6=${arg#vmkit.ip6=} ;;
    vmkit.gw6=*) gw6=${arg#vmkit.gw6=} ;;
    vmkit.probe=*) probes="$probes ${arg#vmkit.probe=}" ;;
    vmkit.dns=*) names="$names ${arg#vmkit.dns=}" ;;
    vmkit.spoof=*) spoof=${arg#vmkit.spoof=} ;;
    vmkit.spoof6=*) spoof6=${arg#vmkit.spoof6=} ;;
    vmkit.serve=*) serve=${arg#vmkit.serve=} ;;
    vmkit.hold=*) hold=${arg#vmkit.hold=} ;;
    vmkit.mark=*) mark=${arg#vmkit.mark=} ;;
    vmkit.vsock=*) vport=${arg#vmkit.vsock=} ;;
  esac
done
probe() { # probe <label> <ip:port>|<[ipv6]:port>
  host=${2%:*}; host=${host#[}; host=${host%]}
  if /bin/busybox nc -w 3 "$host" "${2##*:}" </dev/null >/dev/null 2>&1; then r=open; else r=closed; fi
  echo "VMKIT-PROBE $1 $2 $r"
}
is6() { case $1 in \[*) return 0 ;; *) return 1 ;; esac; }
end() {
  case $method in
    reboot) /bin/busybox reboot -f ;;
    *) /bin/busybox poweroff -f ;;
  esac
}
echo "VMKIT-GUEST-UP action=$action"
case $action in
  up) end ;;
  reboot) /bin/busybox reboot -f ;;
  panic) echo c > /proc/sysrq-trigger ;;
  exit) exit 0 ;;  # PID 1 exiting panics the kernel
  idle) while :; do echo "VMKIT-GUEST-TICK"; /bin/busybox sleep 0.2; done ;;
  vsock) /bin/vsock-hello 1234; end ;;
  sector0)
    # Write a known 512-byte pattern to sector 0 of the first (writable) disk and read it back.
    /bin/busybox yes VMKIT-SECTOR0-PATTERN | /bin/busybox head -c 512 > /pattern
    /bin/busybox dd if=/pattern of=/dev/vda bs=512 count=1 conv=fsync 2>/dev/null
    /bin/busybox dd if=/dev/vda of=/readback bs=512 count=1 iflag=direct 2>/dev/null
    if /bin/busybox cmp /pattern /readback; then r=ok; else r=fail; fi
    echo "VMKIT-SECTOR0 $r"
    end ;;
  net)
    /bin/busybox ip link set lo up
    /bin/busybox ip addr add "$ip" dev eth0
    /bin/busybox ip link set eth0 up
    /bin/busybox ip route add default via "$gw"
    if [ -n "$ip6" ]; then
      # No duplicate address detection, so the address is usable at once.
      echo 0 > /proc/sys/net/ipv6/conf/eth0/accept_dad
      /bin/busybox ip -6 addr add "$ip6" dev eth0
      /bin/busybox ip -6 route add default via "$gw6" dev eth0
    fi
    echo "VMKIT-NET-CONFIGURED"
    if [ -n "$serve" ]; then
      /bin/busybox mkdir -p /srv && echo VMKIT-SERVED > /srv/index.html
      /bin/busybox httpd -p "$serve" -h /srv && echo "VMKIT-SERVING $serve"
    fi
    for p in $probes; do probe tcp "$p"; done
    for n in $names; do
      if /bin/busybox nslookup "$n" "$gw" >/dev/null 2>&1; then r=ok; else r=fail; fi
      echo "VMKIT-DNS $n $r"
    done
    if [ -n "$spoof" ]; then
      # Send from an address the host did not assign (the route's preferred source).
      /bin/busybox ip addr add "$spoof" dev eth0
      /bin/busybox ip route replace default via "$gw" src "${spoof%/*}"
      for p in $probes; do is6 "$p" || probe spoofed "$p"; done
    fi
    if [ -n "$spoof6" ]; then
      /bin/busybox ip -6 addr add "$spoof6" dev eth0
      /bin/busybox ip -6 route replace default via "$gw6" dev eth0 src "${spoof6%/*}"
      for p in $probes; do is6 "$p" && probe spoofed "$p"; done
    fi
    /bin/busybox sleep "$hold"
    end ;;
  count)
    # The counter lives in guest memory and the mark on the disk: a restored guest goes on
    # counting from where its snapshot was taken, and reads the mark back with direct I/O.
    if [ -b /dev/vda ]; then
      echo "VMKIT-MARK-$mark" | /bin/busybox dd of=/dev/vda bs=512 count=1 conv=sync,fsync 2>/dev/null
    fi
    i=0
    while :; do
      i=$((i+1))
      d=
      if [ -b /dev/vda ]; then
        d=$(/bin/busybox dd if=/dev/vda bs=512 count=1 iflag=direct 2>/dev/null | /bin/busybox head -n 1)
      fi
      echo "VMKIT-COUNT $i $d"
      if [ -n "$vport" ]; then /bin/vsock-hello "$vport" 2>/dev/null; fi
      /bin/busybox sleep 0.2
    done ;;
  disks)
    for d in /sys/block/vd*; do echo "VMKIT-DISK $(/bin/busybox basename "$d") $(/bin/busybox cat "$d/size")"; done
    end ;;
esac
/bin/busybox sleep 5
echo "VMKIT-GUEST-FELL-THROUGH"
